# Build output
build/
cmake-build-*/
out/
dist/
CMakeUserPresets.json

# MSVC / MSBuild (the WinUI 3 GUI project in M11 is MSBuild-driven)
*.vcxproj.user
*.aps
.vs/
Debug/
Release/
x64/
packages/
*.pdb
*.ilk
*.idb

# Model data. A .gturbo install is ~14.3 GB and the source checkpoint ~15 GB;
# neither belongs anywhere near version control. Anchored so they cannot
# accidentally swallow a source directory of the same name.
*.gturbo/
/scratch/
/model-data/
*.safetensors
*.gguf

# Generated test fixtures (scripts/gen_golden_tokens.py output)
tests/data/generated/

# The XAML markup compiler writes these into the source directory rather than
# the intermediate one. Both are stamped "generated by the build".
src/gui/XamlMetaDataProvider.idl
src/gui/XamlMetaDataProvider.cpp

# IDE. Editor configuration is per-developer and belongs to whoever is
# holding the editor, not to the repository.
.idea/
.vscode/

# Python venv for the dev-time fixture-generation scripts
.venv/
__pycache__/

# MSBuild output for the GUI, which CMake does not own.
build/gui/
src/gui/obj/
src/gui/x64/
*.log
